datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------------------------
// 1. PRODUCTS & MAIN WAREHOUSE INVENTORY
// --------------------------------------------------------
model Product {
  id            String   @id @default(uuid())
  sku           String   @unique
  barcode       String?  // Retail / Manufacturer 1D/2D Barcode (e.g. EAN-13, UPC, QR)
  name          String
  category      String   @default("General")
  unit          String   @default("Unit") // e.g., Case, Box, Pack, Kg
  unitPrice     Float // Base selling price
  costPrice     Float // Purchase cost price
  currentStock  Int      @default(0) // Warehouse main stock
  freeStock     Int      @default(0) // Warehouse promotional free issue stock (Cost = 0)
  damageStock   Int      @default(0) // Damaged / expired returned stock
  minStockAlert Int      @default(10)
  freeRatioBuy  Int      @default(0) // Buy X (e.g. 10)
  freeRatioGet  Int      @default(0) // Get Y Free (e.g. 1)
  isRawMaterial Boolean  @default(false) // Raw materials / packaging vs finished goods
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  orderItems         OrderItem[]
  stockMovements     StockMovement[]
  lorryStocks        LorryStock[]
  loadingItems       LorryLoadingItem[]
  purchaseOrderItems PurchaseOrderItem[]
  orderReturns       OrderReturn[]
  recipes            Recipe[]            @relation("ProductRecipes")
  recipeItems        RecipeItem[]        @relation("RecipeComponents")
  productionRunItems ProductionRunItem[] @relation("RunConsumedItems")
}

model StockMovement {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        String // INBOUND (Supplier), LORRY_LOAD (Out to lorry), LORRY_RETURN (Back to warehouse), ADJUSTMENT, RETURN
  quantity    Int // Movement amount
  isFreeIssue Boolean  @default(false) // Whether this movement is for zero-cost free issue stock
  referenceId String? // Linked Order ID, Loading ID, or Supplier Invoice #
  notes       String?
  createdAt   DateTime @default(now())
}

// --------------------------------------------------------
// 2. ROUTES & 3 LORRIES FLEET
// --------------------------------------------------------
model Route {
  id          String   @id @default(uuid())
  code        String   @unique // e.g., "R-01", "R-02", "R-03"
  name        String // e.g., "Route 1 - Colombo South"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lorries   Lorry[]
  customers Customer[]
  orders    Order[]
}

model Lorry {
  id            String   @id @default(uuid())
  vehicleNumber String   @unique // e.g. "WP-DA-1024"
  driverName    String // e.g. "Sunil Perera"
  driverPhone   String?
  routeId       String?
  route         Route?   @relation(fields: [routeId], references: [id])
  status        String   @default("ACTIVE") // ACTIVE, MAINTENANCE
  
  // Real-time Driver GPS Tracking
  currentLatitude    Float?
  currentLongitude   Float?
  heading            Float?
  speed              Float?
  lastLocationUpdate DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  loadings         LorryLoading[]
  lorryStocks      LorryStock[]
  orders           Order[]
  expenses         Expense[]
  customerPayments CustomerPayment[]
  users            User[]
  locationLogs     LorryLocationHistory[]
  visits           CustomerVisit[]
}

// Historical breadcrumb GPS track log for lorries/drivers
model LorryLocationHistory {
  id         String   @id @default(uuid())
  lorryId    String
  lorry      Lorry    @relation(fields: [lorryId], references: [id], onDelete: Cascade)
  userId     String?
  latitude   Float
  longitude  Float
  speed      Float?
  heading    Float?
  battery    Float?
  recordedAt DateTime @default(now())

  @@index([lorryId, recordedAt])
}

// Real-time floating inventory held on each lorry
model LorryStock {
  id        String   @id @default(uuid())
  lorryId   String
  lorry     Lorry    @relation(fields: [lorryId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity     Int      @default(0) // Regular floating stock
  freeQuantity Int      @default(0) // Free issue floating stock (Cost = 0)
  updatedAt    DateTime @updatedAt

  @@unique([lorryId, productId])
}

// Morning loading & Evening settlement ledger
model LorryLoading {
  id                 String    @id @default(uuid())
  loadingNumber      String    @unique // e.g. "LOAD-20261030-001"
  lorryId            String
  lorry              Lorry     @relation(fields: [lorryId], references: [id])
  routeId            String?
  date               DateTime  @default(now())
  status             String    @default("LOADED") // LOADED, IN_TRANSIT, SETTLED
  notes              String?
  totalLoadedItems   Int       @default(0)
  totalSoldItems     Int       @default(0)
  totalFreeItems     Int       @default(0) // Promotional free units given
  totalReturnedItems Int       @default(0)
  totalSalesAmount   Float     @default(0.0)
  cashCollected      Float     @default(0.0)
  creditGiven        Float     @default(0.0)
  settledAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  items    LorryLoadingItem[]
  expenses Expense[]
}

model LorryLoadingItem {
  id             String       @id @default(uuid())
  loadingId      String
  loading        LorryLoading @relation(fields: [loadingId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  loadedQty       Int // Morning loaded qty (regular)
  loadedFreeQty   Int          @default(0) // Morning loaded qty (free issue)
  soldQty         Int          @default(0) // Sum of sales recorded via paper bills
  freeQty         Int          @default(0) // Free promotional units issued
  returnedQty     Int          @default(0) // Returned back to warehouse at settlement (regular)
  returnedFreeQty Int          @default(0) // Returned back to warehouse at settlement (free issue)
  discrepancyQty  Int          @default(0) // Difference (loaded - sold - free - returned)
}

// --------------------------------------------------------
// 3. CUSTOMERS & CLIENTS
// --------------------------------------------------------
model Customer {
  id                 String   @id @default(uuid())
  code               String   @unique // e.g. "CUST-001"
  name               String
  companyName        String?
  phone              String
  deliveryAddress    String
  city               String   @default("Local")
  routeId            String?
  route              Route?   @relation(fields: [routeId], references: [id])
  pricingTier        String   @default("STANDARD") // STANDARD, WHOLESALE, VIP
  discountPercentage Float    @default(0.0) // Flat discount %
  creditLimit        Float    @default(50000.0)
  outstandingBalance Float    @default(0.0) // Current credit balance
  maxCreditInvoices  Int      @default(1) // Max allowed unpaid bills before knock-off settlement required

  // Geolocation & Mapping
  latitude           Float?
  longitude          Float?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orders   Order[]
  payments CustomerPayment[]
  visits   CustomerVisit[]
}

// --------------------------------------------------------
// 3.1 GEOFENCED STORE VISIT VERIFICATION & AUDIT LOG
// --------------------------------------------------------
model CustomerVisit {
  id              String    @id @default(uuid())
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lorryId         String
  lorry           Lorry     @relation(fields: [lorryId], references: [id], onDelete: Cascade)
  userId          String?
  date            DateTime  @default(now()) // Delivery run date
  checkInTime     DateTime  @default(now())
  checkOutTime    DateTime?
  durationMinutes Int?      @default(0)
  distanceMeters  Float?    // Distance to store geofence center in meters
  status          String    @default("VERIFIED") // VERIFIED, MANUAL, SKIPPED
  orderId         String?   // Linked Order ID if sale was taken
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([lorryId, date])
  @@index([customerId, date])
}

// --------------------------------------------------------
// 4. ORDERS & EVENING OFFICE BILL ENTRY
// --------------------------------------------------------
model Order {
  id              String   @id @default(uuid())
  orderNumber     String   @unique // e.g. "ORD-20261030-0001"
  paperBillNumber String? // Physical paper bill slip number brought by driver
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  lorryId         String?
  lorry           Lorry?   @relation(fields: [lorryId], references: [id])
  routeId         String?
  route           Route?   @relation(fields: [routeId], references: [id])
  status          String   @default("DELIVERED") // PENDING, DELIVERED, CANCELLED
  paymentStatus   String   @default("PAID") // UNPAID, PARTIAL, PAID
  paymentMethod   String   @default("CASH") // CASH, CREDIT, CHEQUE

  subtotal       Float
  discountAmount Float @default(0.0)
  taxAmount      Float @default(0.0)
  returnAmount   Float @default(0.0) // Value of returned/damaged goods deducted from bill
  netTotal       Float
  cashReceived   Float @default(0.0)
  paidAmount     Float @default(0.0) // Total amount paid against this specific bill
  balanceAmount  Float @default(0.0) // Remaining unpaid balance on this bill

  notes        String?
  chequeNumber String?
  bankName     String?
  chequeDate   DateTime?
  dispatchedAt DateTime?
  deliveredAt  DateTime? @default(now())
  
  // Geolocation capture at time of bill creation
  latitude     Float?
  longitude    Float?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items       OrderItem[]
  returns     OrderReturn[]
  allocations BillPaymentAllocation[]
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  quantity     Int // Billed / Paid quantity
  freeQuantity Int     @default(0) // Free issues given on promotion
  unitPrice    Float
  lineTotal    Float
}

model OrderReturn {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int // Returned quantity
  unitPrice  Float // Credit rate per unit
  total      Float // Line total (quantity * unitPrice)
  returnType String   @default("DAMAGE") // "DAMAGE" (market return/expired) or "RESALE" (good condition)
  reason     String? // Return reason description
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

// --------------------------------------------------------
// 5. SUPPLIERS & PROCUREMENT (GOODS RECEIVED NOTES - GRN)
// --------------------------------------------------------
model Supplier {
  id                 String   @id @default(uuid())
  code               String   @unique // e.g. "SUP-001"
  name               String // e.g. "Ceylon Tea Exporters (Pvt) Ltd"
  contactPerson      String? // e.g. "Rohan De Silva"
  phone              String // e.g. "+94 11 234 5678"
  email              String?
  address            String?
  city               String   @default("Colombo")
  paymentTerms       String?  @default("NET 30") // NET 15, NET 30, CASH ON DELIVERY
  outstandingBalance Float    @default(0.0) // Balance owed to supplier
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  products       Product[]
  purchaseOrders PurchaseOrder[]
  users          User[]
}

model PurchaseOrder {
  id                    String    @id @default(uuid())
  orderNumber           String    @unique // e.g. "PO-20261031-001" or "GRN-001"
  supplierInvoiceNumber String? // Physical bill / invoice number from the supplier
  supplierId            String
  supplier              Supplier  @relation(fields: [supplierId], references: [id])
  status                String    @default("RECEIVED") // DRAFT, ORDERED, RECEIVED, CANCELLED
  paymentStatus         String    @default("PAID") // PAID, PARTIAL, UNPAID
  paymentMethod         String    @default("BANK_TRANSFER") // CASH, BANK_TRANSFER, CHEQUE
  date                  DateTime  @default(now())
  subtotal              Float
  taxAmount             Float     @default(0.0)
  totalAmount           Float
  paidAmount            Float     @default(0.0)
  notes                 String?
  receivedAt            DateTime? @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  items PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity     Int // Paid units received into warehouse stock
  freeQuantity Int           @default(0) // Free issue units received from supplier (Cost = 0)
  costPrice    Float // Purchase price per unit
  lineTotal    Float // quantity * costPrice (freeQuantity has 0 cost)
}

// --------------------------------------------------------
// 6. OPERATING EXPENDITURES & EXPENSES (OPEX)
// --------------------------------------------------------
model Expense {
  id              String        @id @default(uuid())
  expenseNumber   String        @unique // e.g. "EXP-20261031-0001"
  category        String        // FUEL, VEHICLE_MAINTENANCE, DRIVER_ALLOWANCE, RENT, UTILITIES, SALARIES, PACKAGING, PETTY_CASH, OTHER
  title           String        // Short summary / title
  amount          Float
  date            DateTime      @default(now())
  paymentMethod   String        @default("CASH") // CASH, BANK_TRANSFER, CHEQUE
  referenceNumber String?       // Receipt / Bill / Cheque #
  paidTo          String?       // Vendor or Payee
  notes           String?
  lorryId         String?
  lorry           Lorry?        @relation(fields: [lorryId], references: [id], onDelete: SetNull)
  loadingId       String?
  loading         LorryLoading? @relation(fields: [loadingId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// --------------------------------------------------------
// 7. CUSTOMER CREDIT PAYMENTS & SETTLEMENT RECEIPTS
// --------------------------------------------------------
model CustomerPayment {
  id            String    @id @default(uuid())
  receiptNumber String    @unique // e.g. "RCPT-20261031-0001"
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount        Float
  paymentMethod String    @default("CASH") // CASH, CHEQUE, BANK_TRANSFER
  chequeNumber  String?
  bankName      String?
  chequeDate    DateTime?
  chequeStatus  String?   @default("PENDING") // PENDING (In Hand), DEPOSITED, CLEARED, BOUNCED
  depositDate   DateTime?
  clearedDate   DateTime?
  bouncedDate   DateTime?
  depositBank   String?
  bounceReason  String?
  reference     String?   // e.g. Bank slip or transaction ID
  notes         String?
  collectedBy   String?   // Driver name, Sales rep, or Cashier
  lorryId       String?
  lorry         Lorry?    @relation(fields: [lorryId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  allocations BillPaymentAllocation[]
}

// --------------------------------------------------------
// 7.1 BILL-TO-BILL PAYMENT ALLOCATIONS (KNOCK-OFF LEDGER)
// --------------------------------------------------------
model BillPaymentAllocation {
  id         String          @id @default(uuid())
  paymentId  String
  payment    CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount     Float           // Amount knocked off this specific bill
  notes      String?
  createdAt  DateTime        @default(now())
}

// --------------------------------------------------------
// 8. MANUFACTURING, BOM RECIPES & PRODUCTION RUNS
// --------------------------------------------------------
model Recipe {
  id                    String   @id @default(uuid())
  code                  String   @unique // e.g. "BOM-001"
  name                  String   // e.g. "Sunlight Detergent 1kg Packaging"
  productId             String   // Target Finished Good
  product               Product  @relation("ProductRecipes", fields: [productId], references: [id], onDelete: Cascade)
  outputYield           Int      @default(1) // Units of finished product produced per batch
  estimatedOverheadCost Float    @default(0.0) // Packaging / labor overhead per batch
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  items          RecipeItem[]
  productionRuns ProductionRun[]
}

model RecipeItem {
  id                 String  @id @default(uuid())
  recipeId           String
  recipe             Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  componentProductId String  // Ingredient / Raw Material / Packaging component
  componentProduct   Product @relation("RecipeComponents", fields: [componentProductId], references: [id])
  quantity           Float   // Quantity needed per recipe output yield
  notes              String?
}

model ProductionRun {
  id                   String              @id @default(uuid())
  batchNumber          String              @unique // e.g. "BATCH-20261031-0001"
  recipeId             String
  recipe               Recipe              @relation(fields: [recipeId], references: [id])
  targetQuantity       Int                 // Planned units of finished goods
  actualQuantity       Int                 @default(0) // Completed output units
  status               String              @default("COMPLETED") // DRAFT, IN_PROGRESS, COMPLETED, CANCELLED
  totalRawMaterialCost Float               @default(0.0)
  overheadCost         Float               @default(0.0)
  totalProductionCost  Float               @default(0.0)
  unitCost             Float               @default(0.0)
  producedBy           String?             // Shift / Operator / Supervisor
  notes                String?
  startDate            DateTime            @default(now())
  completedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  items ProductionRunItem[]
}

model ProductionRunItem {
  id              String        @id @default(uuid())
  productionRunId String
  productionRun   ProductionRun @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  productId       String        // Component product consumed
  product         Product       @relation("RunConsumedItems", fields: [productId], references: [id])
  plannedQuantity Float
  actualQuantity  Float
  unitCost        Float
  lineCost        Float
}

// --------------------------------------------------------
// 9. AUTH & USERS (ADMIN & MOBILE ROUTE REPS)
// --------------------------------------------------------
model User {
  id               String   @id @default(uuid())
  username         String   @unique
  password         String
  fullName         String
  role             String   @default("REP") // "ADMIN" | "REP" | "SUPPLIER"
  phone            String?
  lorryId          String?
  lorry            Lorry?   @relation(fields: [lorryId], references: [id])
  supplierId       String?
  supplier         Supplier? @relation(fields: [supplierId], references: [id])
  status           String   @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  monthlyTarget    Float    @default(0.0) // Monthly revenue target amount
  dailyTarget      Float    @default(0.0) // Daily revenue target amount
  targetNewClients Int      @default(0)   // Monthly new shops onboarding target
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// --------------------------------------------------------
// 10. HR & PAYROLL MANAGEMENT (EMPLOYEES, ATTENDANCE, ADVANCES, PAYROLL)
// --------------------------------------------------------
model Employee {
  id              String          @id @default(uuid())
  employeeNumber  String          @unique // e.g. "EMP-001"
  fullName        String
  callingName     String?         // Familiar name e.g. "Kamal"
  nicNumber       String?         // National ID / NIC
  phone           String
  address         String?
  designation     String          // "Sales Rep", "Lorry Driver", "Head Baker", "Warehouse Staff", "Office Assistant"
  department      String          @default("SALES_FLEET") // "SALES_FLEET", "WAREHOUSE", "MANUFACTURING", "ADMIN"
  employmentType  String          @default("FULL_TIME") // "FULL_TIME", "DAILY_WAGE", "CONTRACT"
  joinDate        DateTime        @default(now())
  status          String          @default("ACTIVE") // "ACTIVE", "INACTIVE", "TERMINATED"

  // Base Pay & Rates
  basicSalary     Float           @default(0.0) // Monthly basic salary
  dailyRate       Float           @default(0.0) // Daily wage if daily paid
  otHourlyRate    Float           @default(0.0) // Hourly overtime rate
  allowances      Float           @default(0.0) // Fixed allowances (Transport, Food, Attendance)
  commissionRate  Float           @default(0.0) // Sales commission % (e.g. 1.5% of monthly route sales)

  // Bank & Statutory Information
  bankName        String?
  branchName      String?
  accountNumber   String?
  epfNumber       String?

  // System Cross-Wiring
  userId          String?         // Mapped to system User ID (for Sales Reps)
  lorryId         String?         // Mapped to vehicle (for Drivers / Reps)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  attendances     Attendance[]
  salaryAdvances  SalaryAdvance[]
  payrolls        Payroll[]
}

model Attendance {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date         DateTime  @default(now()) // Midnight ISO date
  status       String    @default("PRESENT") // "PRESENT", "HALF_DAY", "ABSENT", "LEAVE"
  checkInTime  String?   // e.g. "08:00"
  checkOutTime String?   // e.g. "17:30"
  otHours      Float     @default(0.0)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([employeeId, date])
}

model SalaryAdvance {
  id            String    @id @default(uuid())
  advanceNumber String    @unique // e.g. "ADV-202611-0001"
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount        Float
  date          DateTime  @default(now())
  reason        String?
  paymentMethod String    @default("CASH") // "CASH", "BANK_TRANSFER"
  status        String    @default("DEDUCTED") // "PENDING", "DEDUCTED", "CANCELLED"
  payrollId     String?
  payroll       Payroll?  @relation(fields: [payrollId], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Payroll {
  id               String          @id @default(uuid())
  payslipNumber    String          @unique // e.g. "PAY-202611-0001"
  employeeId       String
  employee         Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month            Int             // 1-12
  year             Int             // e.g. 2026

  // Attendance metrics
  workedDays       Int             @default(0)
  absentDays       Int             @default(0)
  leaveDays        Int             @default(0)
  otHours          Float           @default(0.0)

  // Earnings
  basicSalary      Float           @default(0.0)
  otAmount         Float           @default(0.0)
  allowances       Float           @default(0.0)
  salesCommission  Float           @default(0.0) // Auto-calculated from Lorry sales
  performanceBonus Float           @default(0.0)
  grossEarnings    Float           @default(0.0)

  // Deductions
  advancesDeducted Float           @default(0.0) // Auto-aggregated from SalaryAdvance
  epfDeduction     Float           @default(0.0) // EPF 8%
  employerEpf      Float           @default(0.0) // Employer EPF 12%
  employerEtf      Float           @default(0.0) // Employer ETF 3%
  otherDeductions  Float           @default(0.0)
  totalDeductions  Float           @default(0.0)

  // Net Pay
  netPayable       Float           @default(0.0)

  paymentStatus    String          @default("PAID") // "DRAFT", "APPROVED", "PAID"
  paymentMethod    String          @default("CASH") // "CASH", "BANK_TRANSFER", "CHEQUE"
  paidAt           DateTime?
  expenseId        String?         // Synced to business Expense entry
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  salaryAdvances   SalaryAdvance[]
}
